+
+/* Silo: the pad's own lights while a game has it. Steam for macOS lights a
+ * DualSense in its own colour when it opens it, and again each time it
+ * activates the pad for an app (2 s after a game started, measured on TEKKEN 8,
+ * 2026-11-27, and on every return to Steam): with Steam Input off for the game
+ * that colour said Steam Input drove the pad, which it didn't. So while Wine
+ * has the pad for a game, its lights are the game's, or blue with player 1 as on
+ * a PS5 (Linux's hid-playstation picks the same blue) until the game sets its
+ * own, and they are written again every 2 s, the way the triggers' settings
+ * are followed: Steam's colour shows for at most that long. With Steam Input on
+ * Wine never starts the pad (Silo's Hidraw=0), so Steam's colour stays. */
+static void pad_lights_write(struct iohid_device *impl)
+{
+    BYTE report[64] = {0x02};
+
+    report[2] = 0x04 | 0x10;  /* valid flag 1: light bar, player indicator */
+    report[44] = impl->lights[0];
+    memcpy(report + 45, impl->lights + 1, 3);
+    pad_write_output(impl, report);
+    impl->lights_at = mach_absolute_time();
+}
+
+static void pad_lights(struct iohid_device *impl)
+{
+    BYTE report[64] = {0x02};
+
+    report[39] = 0x02;  /* valid flag 2: light bar setup */
+    report[42] = 0x02;  /* light out: the firmware lets go of the light bar */
+    pad_write_output(impl, report);
+    impl->lights[0] = 0x04;  /* player 1: the middle LED */
+    impl->lights[1] = impl->lights[2] = 0x00;
+    impl->lights[3] = 0x80;
+    pad_lights_write(impl);
+    pad_log("the %s's lights: blue, player 1, kept while the game has the pad\n", impl->model);
+}
+
+static void pad_lights_follow(struct iohid_device *impl)
+{
+    if (impl->lights_at && mach_absolute_time() - impl->lights_at >= bt_ticks(2.0)) pad_lights_write(impl);
 }
 
