Silo patch 0013 — win32u: track GetAsyncKeyState()'s "pressed since" bit in the process

Origin: Zagrios/voile-wine, commit 1c42aa0c (2026-09-26, author Zagrios), a backport of Proton's Wine 4aa2ab99c594
(ValveSoftware/wine). License: LGPL-2.1-or-later, like Wine. Hunks unchanged.

Why Silo carries it: a small Proton fix taken on its merit (user, 2026-11-14). Each key a game polls with
GetAsyncKeyState() used to cost a wineserver round trip to clear its "pressed since" bit; the bit is now derived in the
process from the key's state at the previous call. No measurable change on TEKKEN 8 (2026-11-14), no regression.

---- original commit below (git format-patch, unchanged) ----

From 1c42aa0c6426a1d406907b0be3cd3c574cdb93d8 Mon Sep 17 00:00:00 2001
From: Zagrios <40181755+Zagrios@users.noreply.github.com>
Date: Sat, 26 Sep 2026 14:52:31 +0200
Subject: [PATCH] win32u: Track GetAsyncKeyState()'s recent bit in the process.

A key pressed since the last call made NtUserGetAsyncKeyState() ask the
server to clear its "pressed since" bit, a round trip for each key a game
polls. Derive that bit in the process instead, from the key's state at
the previous call. From Proton's Wine: 4aa2ab99c594 (ValveSoftware/wine).
---
 dlls/win32u/input.c | 22 ++++++++--------------
 1 file changed, 8 insertions(+), 14 deletions(-)

diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index 5736d56c..7a24618a 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -796,8 +796,9 @@ SHORT WINAPI NtUserGetAsyncKeyState( INT key )
     const desktop_shm_t *desktop_shm;
     struct object_lock lock = OBJECT_LOCK_INIT;
     NTSTATUS status;
-    BYTE state = 0;
+    BYTE prev, state = 0;
     SHORT ret = 0;
+    static LONG prev_keystate[256] = {0};
 
     if (key < 0 || key >= 256) return 0;
 
@@ -807,20 +808,13 @@ SHORT WINAPI NtUserGetAsyncKeyState( INT key )
         state = desktop_shm->keystate[key];
 
     if (status) return 0;
-    if (!(state & 0x40)) return (state & 0x80) << 8;
 
-    /* Need to make a server call to reset the last pressed bit */
-    SERVER_START_REQ( get_key_state )
-    {
-        req->async = 1;
-        req->key = key;
-        if (!wine_server_call( req ))
-        {
-            if (reply->state & 0x40) ret |= 0x0001;
-            if (reply->state & 0x80) ret |= 0x8000;
-        }
-    }
-    SERVER_END_REQ;
+    prev = InterlockedExchange(&prev_keystate[key], state);
+
+    if ((state & 0x80) && !(prev & 0x80))
+        ret |= 0x0001;
+    if (state & 0x80)
+        ret |= 0x8000;
 
     return ret;
 }
