+/* Windows applies the IPPROTO_IP options of an AF_INET6 socket to the IPv4 traffic it carries (the
+ * IPv4-mapped peers of a dual-stack socket); macOS rejects them on such a socket with EINVAL, for set and
+ * get alike, so the program sees WSAEINVAL. A game that gives up on that never gets its socket going. Where
+ * the host refuses one of these on an AF_INET6 socket, the IPv6 option that does the same job is used:
+ * on macOS it reaches the IPv4-mapped traffic too (an IPV6_UNICAST_HOPS of 200 makes a datagram sent to
+ * ::ffff:127.0.0.1 arrive with TTL 200). A host that accepts the IPv4 option never comes here. */
+static int ipv4_option_on_ipv6( int fd, int option )
+{
+    struct sockaddr_storage addr;
+    socklen_t len = sizeof(addr);
+    int option6;
+
+    switch (option)
+    {
+    case IP_TTL:            option6 = IPV6_UNICAST_HOPS; break;
+    case IP_MULTICAST_TTL:  option6 = IPV6_MULTICAST_HOPS; break;
+    case IP_MULTICAST_LOOP: option6 = IPV6_MULTICAST_LOOP; break;
+#ifdef IPV6_TCLASS
+    case IP_TOS:            option6 = IPV6_TCLASS; break;
+#endif
+#if defined(IP_DONTFRAG) && defined(IPV6_DONTFRAG)
+    case IP_DONTFRAG:       option6 = IPV6_DONTFRAG; break;
+#endif
+    default: return -1;
+    }
+    if (getsockname( fd, (struct sockaddr *)&addr, &len ) || addr.ss_family != AF_INET6) return -1;
+    return option6;
+}
+
+
+static NTSTATUS do_set_ipv4_option( HANDLE handle, IO_STATUS_BLOCK *io, int option,
+                                    const void *optval, socklen_t optlen )
+{
+    int fd, needs_close = FALSE, option6, value, err = 0;
+    NTSTATUS status;
+
+    if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
+        return status;
+
+    if (setsockopt( fd, IPPROTO_IP, option, optval, optlen )) err = errno;
+    if (err == EINVAL && optlen && (option6 = ipv4_option_on_ipv6( fd, option )) != -1)
+    {
+        /* the IPv6 options take an int; a program may pass a DWORD or a single byte */
+        if (optlen >= sizeof(value)) memcpy( &value, optval, sizeof(value) );
+        else value = *(const unsigned char *)optval;
+        err = setsockopt( fd, IPPROTO_IPV6, option6, &value, sizeof(value) ) ? errno : 0;
+        TRACE( "IPv4 option %d on an IPv6 socket: IPv6 option %d = %d, %s\n",
+               option, option6, value, err ? strerror( err ) : "set" );
+    }
+    if (needs_close) close( fd );
+    if (err) return sock_errno_to_status( err );
+    if (io) io->Status = STATUS_SUCCESS;
+    return STATUS_SUCCESS;
+}
+
+
+static NTSTATUS do_get_ipv4_option( HANDLE handle, IO_STATUS_BLOCK *io, int option,
+                                    void *out_buffer, ULONG out_size )
+{
+    int fd, needs_close = FALSE, option6, value, err = 0;
+    socklen_t len = out_size, len6 = sizeof(value);
+    NTSTATUS status;
+
+    if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
+        return status;
+
+    if (getsockopt( fd, IPPROTO_IP, option, out_buffer, &len )) err = errno;
+    if (err == EINVAL && out_size && (option6 = ipv4_option_on_ipv6( fd, option )) != -1)
+    {
+        err = getsockopt( fd, IPPROTO_IPV6, option6, &value, &len6 ) ? errno : 0;
+        /* an unset hop limit reads -1, meaning the system default; Windows reports the value in use */
+        if (!err && value == -1 && option6 == IPV6_UNICAST_HOPS)
+        {
+            value = 64;
+#ifdef __APPLE__
+            {
+                size_t size = sizeof(value);
+                if (sysctlbyname( "net.inet.ip.ttl", &value, &size, NULL, 0 )) value = 64;
+            }
+#endif
+        }
+        if (!err)
+        {
+            len = min( out_size, sizeof(value) );
+            memcpy( out_buffer, &value, len );
+        }
+    }
+    if (needs_close) close( fd );
+    if (err) return sock_errno_to_status( err );
+    if (io)
+    {
+        io->Status = STATUS_SUCCESS;
+        io->Information = len;
+    }
+    return STATUS_SUCCESS;
+}
+
+
