+                                  kAudioUnitScope_Input, 0, &input, sizeof(input));
+    }
     if(sc != noErr){
-        WARN("Unable to get _NominalSampleRate property: %x\n", (int)sc);
+        WARN("Couldn't set callback: %x\n", (int)sc);
         params->result = osstatus_to_hresult(sc);
-        return STATUS_SUCCESS;
+        goto end;
+    }
