+/* The device a stream plays on now: one that follows the default may have moved since it was
+ * created. Never called with stream->lock held: the unit's own lock may be held by the I/O
+ * thread waiting in ca_render_cb for stream->lock. */
+static AudioDeviceID stream_dev_id(struct coreaudio_stream *stream)
+{
+    AudioDeviceID id;
+    UInt32 size = sizeof(id);
+
+    if(stream->follow_default &&
+       AudioUnitGetProperty(stream->unit, kAudioOutputUnitProperty_CurrentDevice,
+                            kAudioUnitScope_Global, 0, &id, &size) == noErr)
+        return id;
+    return stream->dev_id;
+}
+
+/* A stream that follows the default gives each new device the I/O buffer that unix_create_stream
+ * gave the first one: one period, counted in the device's frames. Runs on CoreAudio's notification
+ * thread and reads only what is fixed once the stream is made, so it takes no stream lock. */
+static void ca_device_changed_cb(void *user, AudioUnit unit, AudioUnitPropertyID id,
+                                 AudioUnitScope scope, AudioUnitElement element)
+{
+    struct coreaudio_stream *stream = user;
+    const AudioDeviceID dev_id = stream_dev_id(stream);
+    unsigned int min_frames, max_frames, rate, frames;
+
+    if (FAILED(get_device_period_frame_range(dev_id, stream->flow, &min_frames, &max_frames)))
+        return;
+    if (FAILED(get_device_sample_rate(dev_id, stream->flow, &rate)) || !rate)
+        rate = stream->fmt->nSamplesPerSec;
+    frames = muldiv(stream->period_frames, rate, stream->fmt->nSamplesPerSec);
+    frames = max(min_frames, min(frames, max_frames));
+    TRACE("stream %p now on device %u, buffer %u frames\n", stream, (unsigned int)dev_id, frames);
+    set_device_period_frame_size(dev_id, stream->flow, frames);
+}
