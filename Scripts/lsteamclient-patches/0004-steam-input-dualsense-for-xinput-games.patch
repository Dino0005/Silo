+/* Silo (lsteamclient patch 0004): with SILO_STEAM_INPUT_DUALSENSE=1 the game is told neither that Steam's overlay
+ * opened or closed (GameOverlayActivated_t, 331) nor that Steam loaded an input configuration
+ * (SteamInputConfigurationLoaded_t, 2803, which comes with the overlay for the pad Steam then holds). On either,
+ * TEKKEN 8 dropped the PlayStation prompts SteamInput006 gave it and showed Xbox ones for the rest of the run
+ * (measured 2026-11-27: hiding 2803 alone, or rewriting its handle to the reported DualSense, was not enough;
+ * hiding both kept the PlayStation prompts). The overlay itself still opens; a game that pauses on it doesn't. The
+ * id becomes one no game registers for. */
+static int silo_steam_input_callback_id( const u_CallbackMsg_t *msg )
+{
+    if (silo_dualsense_enabled() && (msg->m_iCallback == 2803 /* SteamInputConfigurationLoaded_t */ ||
+                                     msg->m_iCallback == 331 /* GameOverlayActivated_t */))
+    {
+        TRACE( "callback %d not passed on (Silo's DualSense)\n", msg->m_iCallback );
+        return 2899;
+    }
+    return msg->m_iCallback;
+}
 
