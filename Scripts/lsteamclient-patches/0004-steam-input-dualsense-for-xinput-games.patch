+/* Silo: with SILO_STEAM_INPUT_DUALSENSE=1 — Silo sets it when the game's "DualSense as an XInput controller" is on
+ * and Steam Input is off for its DualSense — Steam Input reports one DualSense, in
+ * XInput slot 0 where Silo's Wine offers the pad, and nothing else — not even the pad Steam reports while its
+ * overlay is open (it takes the pad for the overlay, and TEKKEN 8 then switched to Xbox prompts for good): games
+ * that read buttons through XInput and take the controller TYPE from Steam Input then show PlayStation prompts.
+ * Other calls with that handle reach Steam unchanged; it knows no such handle and answers with its defaults.
+ * Without the variable, Steam's own answers pass through. */
+#include <stdlib.h>
+#define SILO_DUALSENSE_HANDLE 0x5110d5e000000001ull
+
+static bool silo_dualsense_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        const char *value = getenv( "SILO_STEAM_INPUT_DUALSENSE" );
+        enabled = value && value[0] == '1';
+    }
+    return enabled;
+}
