Silo lsteamclient patch 0002 — native key codes for macOS

Why: ISteamHTMLSurface::KeyDown/KeyUp take a "native" key code. Valve's code has the Linux (X11 keysym) table
and stops with #error on any other platform. On macOS the native code is the Carbon virtual key code
(kVK_* from HIToolbox/Events.h). This table is Silo's own, written from that header's values. Only games that
use Steam's in-game HTML surface go through it; not yet verified on such a game.

--- a/lsteamclient/unix_steam_input_manual.cpp
+++ b/lsteamclient/unix_steam_input_manual.cpp
@@ -192,6 +192,79 @@
         return vk_to_xkeysym[win_vk];
     return 0;
 }
+#elif defined(__APPLE__)
+/* macOS: the native key code is the Carbon virtual key code (kVK_* in HIToolbox/Events.h).
+ * kVK_ANSI_A is 0, the same value as "no mapping". */
+uint32_t manual_convert_nNativeKeyCode( uint32_t win_vk )
+{
+    static const char letters[26] =
+    {
+        0x00, 0x0b, 0x08, 0x02, 0x0e, 0x03, 0x05, 0x04, 0x22, 0x26, 0x28, 0x25, 0x2e, /* A-M */
+        0x2d, 0x1f, 0x23, 0x0c, 0x0f, 0x01, 0x11, 0x20, 0x09, 0x0d, 0x07, 0x10, 0x06, /* N-Z */
+    };
+    static const char digits[10] = { 0x1d, 0x12, 0x13, 0x14, 0x15, 0x17, 0x16, 0x1a, 0x1c, 0x19 };
+    static const char keypad[10] = { 0x52, 0x53, 0x54, 0x55, 0x56, 0x57, 0x58, 0x59, 0x5b, 0x5c };
+    static const char fkeys[20] =
+    {
+        0x7a, 0x78, 0x63, 0x76, 0x60, 0x61, 0x62, 0x64, 0x65, 0x6d, /* F1-F10 */
+        0x67, 0x6f, 0x69, 0x6b, 0x71, 0x6a, 0x40, 0x4f, 0x50, 0x5a, /* F11-F20 */
+    };
+
+    if (win_vk >= 'A' && win_vk <= 'Z') return letters[win_vk - 'A'];
+    if (win_vk >= '0' && win_vk <= '9') return digits[win_vk - '0'];
+    if (win_vk >= 0x60 && win_vk <= 0x69) return keypad[win_vk - 0x60]; /* VK_NUMPAD0-9 */
+    if (win_vk >= 0x70 && win_vk <= 0x83) return fkeys[win_vk - 0x70];  /* VK_F1-F20 */
+
+    switch (win_vk)
+    {
+    case 0x08: return 0x33; /* VK_BACK -> kVK_Delete */
+    case 0x09: return 0x30; /* VK_TAB */
+    case 0x0c: return 0x47; /* VK_CLEAR -> kVK_ANSI_KeypadClear */
+    case 0x0d: return 0x24; /* VK_RETURN */
+    case 0x10: return 0x38; /* VK_SHIFT */
+    case 0x11: return 0x3b; /* VK_CONTROL */
+    case 0x12: return 0x3a; /* VK_MENU -> kVK_Option */
+    case 0x14: return 0x39; /* VK_CAPITAL */
+    case 0x1b: return 0x35; /* VK_ESCAPE */
+    case 0x20: return 0x31; /* VK_SPACE */
+    case 0x21: return 0x74; /* VK_PRIOR */
+    case 0x22: return 0x79; /* VK_NEXT */
+    case 0x23: return 0x77; /* VK_END */
+    case 0x24: return 0x73; /* VK_HOME */
+    case 0x25: return 0x7b; /* VK_LEFT */
+    case 0x26: return 0x7e; /* VK_UP */
+    case 0x27: return 0x7c; /* VK_RIGHT */
+    case 0x28: return 0x7d; /* VK_DOWN */
+    case 0x2d: return 0x72; /* VK_INSERT -> kVK_Help */
+    case 0x2e: return 0x75; /* VK_DELETE -> kVK_ForwardDelete */
+    case 0x2f: return 0x72; /* VK_HELP */
+    case 0x5b: return 0x37; /* VK_LWIN -> kVK_Command */
+    case 0x5c: return 0x36; /* VK_RWIN -> kVK_RightCommand */
+    case 0x6a: return 0x43; /* VK_MULTIPLY */
+    case 0x6b: return 0x45; /* VK_ADD */
+    case 0x6d: return 0x4e; /* VK_SUBTRACT */
+    case 0x6e: return 0x41; /* VK_DECIMAL */
+    case 0x6f: return 0x4b; /* VK_DIVIDE */
+    case 0xa0: return 0x38; /* VK_LSHIFT */
+    case 0xa1: return 0x3c; /* VK_RSHIFT */
+    case 0xa2: return 0x3b; /* VK_LCONTROL */
+    case 0xa3: return 0x3e; /* VK_RCONTROL */
+    case 0xa4: return 0x3a; /* VK_LMENU */
+    case 0xa5: return 0x3d; /* VK_RMENU */
+    case 0xba: return 0x29; /* VK_OEM_1 ; */
+    case 0xbb: return 0x18; /* VK_OEM_PLUS = */
+    case 0xbc: return 0x2b; /* VK_OEM_COMMA */
+    case 0xbd: return 0x1b; /* VK_OEM_MINUS */
+    case 0xbe: return 0x2f; /* VK_OEM_PERIOD */
+    case 0xbf: return 0x2c; /* VK_OEM_2 / */
+    case 0xc0: return 0x32; /* VK_OEM_3 ` */
+    case 0xdb: return 0x21; /* VK_OEM_4 [ */
+    case 0xdc: return 0x2a; /* VK_OEM_5 \ */
+    case 0xdd: return 0x1e; /* VK_OEM_6 ] */
+    case 0xde: return 0x27; /* VK_OEM_7 ' */
+    }
+    return 0;
+}
 #else
 #error You must implement VK<->Native keysym conversion for this platform.
 #endif
