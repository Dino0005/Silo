+// D3D defines an out-of-range raw/structured buffer load as 0 and drops an out-of-range store. Pointing the access
+// at a null address (CreateGEPInt32WithBoundCheck) gives neither on Metal, so loads and stores also test this.
+llvm::Value *
+Converter::BufferIndexInBounds(BufferResourceHandle &Buffer, llvm::Value *Index) {
+  if (!Buffer.Metadata)
+    return nullptr;
+  return ir.CreateICmpULT(Index, ir.CreateLShr(DecodeRawBufferByteLength(Buffer.Metadata), 2));
+}
+
+llvm::Value *
+Converter::BufferIndexInBounds(AtomicBufferResourceHandle &Buffer, llvm::Value *Index) {
+  if (!Buffer.Metadata)
+    return nullptr;
+  return ir.CreateICmpULT(Index, ir.CreateLShr(DecodeRawBufferByteLength(Buffer.Metadata), 2));
+}
+
 llvm::Value *
 Converter::CreateGEPInt32WithBoundCheck(BufferResourceHandle &Buffer, llvm::Value *Index) {
   auto Addr = ir.CreateGEP(ir.getInt32Ty(), Buffer.Pointer, {Index});
