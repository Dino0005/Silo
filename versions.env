# Silo — SINGLE SOURCE OF TRUTH for every version number in the project.
#
# Edit a version here, then regenerate the committed Swift mirror:
#   Scripts/gen-versions.sh        # writes Sources/SiloKit/Versions.swift
# (Scripts/build-app.sh runs it for you.) Nothing else in the repo should hard-code a version.
#
# Shell-sourceable (KEY=VALUE, no spaces) so every script AND the Swift codegen read the exact same values.

# --- Silo app ---
SILO_VERSION=0.6.7
# GitHub repo (owner/name) whose releases host the runtimes the app installs: wine-cx-*, dxmt-* and the
# gst-libav-* add-on. This fork's own since 2026-10-01 (it builds and publishes them; upstream's were older).
# The app UPDATER is pinned separately (Silo.updateRepo), so re-syncing this file from upstream can't move it.
SILO_GITHUB_REPO=Dino0005/Silo

# --- Toolchain for the RELEASE build (CI input only — NOT mirrored into Versions.swift) ---
# release.yml runs on GitHub's `xcode-27` image (hosted, still "preview" — actions/runner-images #14404)
# and selects /Applications/Xcode_<XCODE_VERSION>.app, then pins the SDK via Scripts/sdk-env.sh, so the
# published app is compiled against the same SDK as the local builds. Wine/DXMT CI stays on macos-26.
XCODE_VERSION=27.0
MACOS_SDK_VERSION=27.0

# --- Wine runtime (built from CrossOver's FOSS source in CI) ---
# The CrossOver source version that Scripts/build-wine.sh / .github/workflows/build-wine.yml compile from
# (crossover-sources-<ver>.tar.gz at media.codeweavers.com/pub/crossover/source/). The app downloads the
# LATEST published wine-cx-* release at runtime, so this pins the BUILD input, not what the app loads.
# (CI's wine-autoupdate.yml may bump past this automatically when CrossOver ships a newer source.)
CROSSOVER_VERSION=26.3.0

# --- SDL (winebus's game-controller backend — build-input only, not mirrored to Versions.swift) ---
# The EXACT SDL CrossOver ships (same winebus source, so identical SDL-init code) — a generic Homebrew
# libSDL2 aborted Wine off the main thread; this pinned version, built from source, does not. Wine's
# --with-sdl links against this (see build-wine.sh / build-wine.yml).
SDL_VERSION=2.30.12

# --- DXMT runtime (the optional older-games D3D10/11 backend) ---
# 3Shain's DXMT is the Metal translation layer Silo overlays as the GPTK fallback. Scripts/build-dxmt.sh
# / .github/workflows/build-dxmt.yml build it from this upstream tag against the CrossOver Wine above.
# Pinned to the EXACT version CrossOver 26 bundles, so DXMT ↔ Wine is the pairing CrossOver itself ships
# (CrossOver vendors DXMT from this same upstream — building it here keeps the canonical, reproducible
# build incl. its git submodules). DXMT is NOT Wine, so constraint #8 (Wine = CrossOver-FOSS only) is
# unaffected. LLVM_MINGW_VERSION is the cross-toolchain (mstorsjo/llvm-mingw) DXMT's cross-file pins.
DXMT_REPO=3Shain/dxmt
DXMT_VERSION=v0.72
LLVM_MINGW_VERSION=20231017
# The LLVM statically linked into DXMT's winemetal.so (its shader converter). DXMT's configure.sh pins
# llvmorg-15.0.7; Scripts/build-llvm15.sh builds it from this release tarball with DXMT's own cmake recipe
# (x86_64 Homebrew's llvm@15 before 2026-09-30). The sha256 is the one Homebrew's llvm@15 formula lists too.
DXMT_LLVM_VERSION=15.0.7
DXMT_LLVM_SHA256=8b5fcb24b4128cf04df1b0b9410ce8b1a729cb3c544e6da885d234280dedeac6

# --- GStreamer media add-on: libav (FFmpeg) + matroska, for CrossOver's GStreamer 1.24.4 ---
# Build input only, not mirrored to Versions.swift. Scripts/build-gst-libav.sh builds GStreamer 1.24.4 +
# glib 2.78 from the CrossOver FOSS tarball (the exact versions CrossOver ships — a plugin built for a
# newer minor is refused by the 1.24 core, gstplugin.c) and gst-libav/matroska against FFMPEG_VERSION:
# 6.1 is what that GStreamer's own FFmpeg.wrap pins. NASM_VERSION assembles FFmpeg's x86 SIMD code.
FFMPEG_VERSION=6.1.2
NASM_VERSION=2.16.03

# --- Shipped runtime libs (Scripts/build-deps.sh — build input only) ---
# gmp and gnutls are built from the CrossOver FOSS tarball itself. The tarball's nettle and freetype are git
# exports without their generated build files (nettle lacks Makefile.in — a `/Makefile` .gitignore rule ate
# it; freetype lacks builds/unix/configure), so those two come from their official releases at the SAME
# versions, pinned by sha256. Every file both trees have is identical (diffed 2026-09-30).
NETTLE_VERSION=3.10
NETTLE_SHA256=b4c518adb174e484cb4acea54118f02380c7133771e7e9beb98a0787194ee47c
FREETYPE_VERSION=2.13.3
FREETYPE_SHA256=0550350666d427c74daeb85d5ac7bb353acba5f76956395995311a9c6f063289

# --- Wine's PE cross compiler (build-wine.sh / build-wine.yml — build input only) ---
# Wine's Windows-side DLLs are compiled by mingw-w64 GCC. Pinned to the EXACT Homebrew bottle the working
# from-source runtime was built with (GCC 16.1.0; verified on DMC5 + TEKKEN 8, 2026-09-29), fetched by digest
# from Homebrew's registry and poured by brew — never "whatever brew install gives today" (by then 14.0.0_3,
# GCC 16.2.0). CrossOver itself uses GCC 13.2; llvm-mingw 20231017 was tried and broke Steam's sign-in.
# The ARM64 bottle (arm64_tahoe = macOS 26, the CI runner): x86_64 Homebrew can't be installed any more; the
# tested runtime was built by the x86_64 bottle (sonoma, 4ac74ed7…) of this same revision.
# Bump deliberately: new revision + its arm64_tahoe bottle digest + formula commit + the GCC version it must report.
MINGW_W64_BOTTLE=14.0.0_1
MINGW_W64_BOTTLE_SHA256=11aff599c273a14b7b2b8f75cafe4b0e698fb20062f1aeb549ec913fe57198de
# homebrew-core commit whose Formula/m/mingw-w64.rb carries that bottle (installed from a local tap).
MINGW_W64_FORMULA_COMMIT=46205951aeabce8d7753610dfa0a4b91ebb4e301
MINGW_GCC_VERSION=16.1.0
